# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Androidのリリース署名（鍵と、その場所・パスワードを書いた設定）。リポジトリには入れない
/android/key.properties
*.jks
*.keystore

# Xcodeのビルド時に生成されるSwift Package Managerの解決結果
/ios/Runner.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
/ios/Runner.xcworkspace/xcshareddata/swiftpm/

# CocoaPodsの統合ファイル（`flutter build`が生成する）
/ios/Podfile
/ios/Podfile.lock
/ios/Pods/

# 店舗データの比較スクリプトの結果と、公開しない地点（tool/place_benchmark）
/tool/place_benchmark/results/
/tool/place_benchmark/points.local.json

# リリースの設定など、公開リポジトリにコミットしない値
/env/
/.wrangler/
