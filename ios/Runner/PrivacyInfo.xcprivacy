<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 根拠とストアの回答は docs/release/README.md の「ストアのプライバシーの回答」。
	     集めるデータはストアの「App のプライバシー」の回答と同じものを書く（GoogleAppMeasurement は
	     マニフェストを同梱していないので、Analytics の分もここに書く）。API は、マニフェストを持たない
	     sqlite3.framework（drift の SQLite）の分だけを書く（Flutter・Firebase・各プラグインは自前で申告している）。 -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
